{
  "name": "@quick-mcp/test",
  "version": "0.1.0",
  "description": "LLM-powered testing tool for Quick-MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quick-mcp-test": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "update-models": "node --experimental-strip-types scripts/update-ollama-models.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "llm",
    "ai",
    "openapi"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.11.2",
    "ai": "^4.2.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ollama-ai-provider": "^1.2.0",
    "ora": "^8.1.1",
    "table": "^6.8.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "eslint": "^9.25.1",
    "typescript": "~5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "@quick-mcp/core": "workspace:*"
  }
}